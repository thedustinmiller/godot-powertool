# OS
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Web Frontend (optional - run `cargo xtask web setup` to enable)
# =============================================================================
# Node modules
web/node_modules/

# Lock files (regenerated on npm install)
web/package-lock.json
web/pnpm-lock.yaml
web/yarn.lock

# Build output
web/dist/

# Playwright
web/test-results/
web/playwright-report/
web/.playwright/

# Exported Godot game files (produced by `cargo xtask web export`)
web/public/godot.*
web/public/extension.*

